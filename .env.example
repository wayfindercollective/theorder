# ============================================================
# THE ORDER — environment variables
# Copy to .env.local for local dev. Set in Vercel for prod.
# Site builds and runs fine WITHOUT these — placeholder defaults
# make the offline-first submit queue absorb failed posts gracefully.
# ============================================================

# Funnel slug + site domain — sent in payload for routing / attribution.
VITE_FUNNEL_SLUG=the-order
VITE_SITE_DOMAIN=theorder.global

# Booking calendar embedded after the last question. The committed default in
# src/config/booking.js is the source of truth; set this only to point a
# preview at a test calendar.
VITE_WAYFINDER_BOOKING_URL=

# NOTE: VITE_WAYFINDER_WEBHOOK_URL / VITE_WAYFINDER_API_KEY are RETIRED as
# browser vars. The funnel is booking-gated now (BOOKING_GATED_LEADS.md): the
# browser posts to our own /api/funnel-lead, which holds the secret.
# The relay reads BOTH of them server-side as fallbacks, so the cutover works
# before the new vars are added. Once WAYFINDER_FUNNEL_SECRET is set, DELETE
# VITE_WAYFINDER_API_KEY from Vercel — anything VITE_ is baked into the public
# bundle, and the secret has no business being there.

# PostHog (optional — no-op if absent). Our product-analytics tool.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 (optional — no-op if absent). For the ads agency.
# Create the property under Nico's Google account, then copy the Measurement ID.
# Shape: G-XXXXXXXXXX  →  Admin → Data Streams → Web → Measurement ID
VITE_GA4_MEASUREMENT_ID=

# Meta / Facebook Pixel (optional — no-op if absent). For ad optimization + retargeting.
# Numeric ID from Meta Events Manager once the ad account / Business Manager exists.
# Fires PageView on load and a standard `Lead` event on form submit.
VITE_META_PIXEL_ID=

# ============================================================
# WAYFINDER LEAD RELAY (/api/funnel-lead — server-side only)
# The funnel secret must never be VITE_-prefixed; these are read by the
# serverless function, never by the browser.
# ============================================================

# The funnel's webhookSecret from Wayfinder OS → funnel settings (fnl_…).
# Sent to Wayfinder as X-API-Key (and Authorization: Bearer, same value).
WAYFINDER_FUNNEL_SECRET=

# Where the relay posts. Resolution order:
#   1. WAYFINDER_LEAD_URL          — explicit full URL, always wins
#   2. VITE_WAYFINDER_WEBHOOK_URL  — the existing live webhook (used by default,
#                                    so nothing breaks before the OS ships its
#                                    new app-host route)
#   3. WAYFINDER_OS_ORIGIN + WAYFINDER_FUNNEL_SLUG
# NOTE the slug in the URL is "the-order-funnel", NOT the same string as
# VITE_FUNNEL_SLUG above — that one is only a payload field.
# WAYFINDER_LEAD_URL=
# WAYFINDER_FUNNEL_SLUG=the-order-funnel
# WAYFINDER_OS_ORIGIN=https://wayfindercollective.io

# ============================================================
# ADMIN / CMS (/admin route)
# Required for /admin to work. Set in Vercel → Project → Environment Variables.
# Do NOT prefix with VITE_ — these are server-side only.
# ============================================================

# Password Peter uses to log in at /admin
ADMIN_PASSWORD=

# Random 32-byte hex string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# GitHub Personal Access Token with `repo` scope.
# Create at: https://github.com/settings/tokens?type=beta
# Scope: contents read+write on this repo only.
GITHUB_TOKEN=

# Owner/repo for content commits.
GITHUB_REPO=wayfindercollective/theorder

# Branch the CMS commits to. Defaults to "main" if unset.
GITHUB_BRANCH=main

# Vercel Blob token — auto-populated when you enable Blob in Vercel dashboard.
# Storage → Connect Blob Store → set as BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=
