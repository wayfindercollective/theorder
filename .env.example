# ============================================================
# THE ORDER - environment variables
# Copy to .env.local for local dev. Set production values in Vercel.
# ============================================================

# Booking calendar embedded only at /application. The committed default in
# src/config/booking.js is the source of truth; use this to point a preview at
# a test calendar.
VITE_WAYFINDER_BOOKING_URL=

# Application leads. Qualified applicants are POSTed to /api/funnel-lead,
# which forwards them to the Wayfinder funnel lead API. Server-side only:
# do NOT prefix these with VITE_ (that would publish the secret).
# The funnel's webhookSecret, from Wayfinder OS funnel settings. Required.
WAYFINDER_FUNNEL_SECRET=
# Optional. Full lead URL; wins over origin + slug below.
WAYFINDER_LEAD_URL=
# Optional. Defaults: https://wayfindercollective.io and the-order-funnel.
WAYFINDER_OS_ORIGIN=
WAYFINDER_FUNNEL_SLUG=

# PostHog (optional).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 (optional).
VITE_GA4_MEASUREMENT_ID=

# Meta / Facebook Pixel (optional).
VITE_META_PIXEL_ID=

# ============================================================
# ADMIN / CMS (/admin route)
# Required for /admin to work. Do not prefix these with VITE_.
# ============================================================

ADMIN_PASSWORD=

# Random 32-byte hex string used to sign JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# GitHub fine-grained token with contents read/write access to this repo.
GITHUB_TOKEN=
GITHUB_REPO=wayfindercollective/theorder

# Branch the CMS commits to. Defaults to main if unset.
GITHUB_BRANCH=main

# Vercel Blob token for CMS image/video uploads.
BLOB_READ_WRITE_TOKEN=
