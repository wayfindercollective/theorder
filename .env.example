# ============================================================
# THE ORDER - environment variables
# Copy to .env.local for local dev. Set production values in Vercel.
# ============================================================

# Booking calendar embedded only at /booking. The committed default in
# src/config/booking.js is the source of truth; use this to point a preview at
# a test calendar.
VITE_WAYFINDER_BOOKING_URL=

# The public application is a local qualification filter. It has no Wayfinder
# webhook, API key, funnel slug or lead relay configuration.

# PostHog (optional).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 (optional).
VITE_GA4_MEASUREMENT_ID=

# Meta / Facebook Pixel (optional).
VITE_META_PIXEL_ID=

# ============================================================
# ADMIN / CMS (/admin route)
# Required for /admin to work. Do not prefix these with VITE_.
# ============================================================

ADMIN_PASSWORD=

# Random 32-byte hex string used to sign JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# GitHub fine-grained token with contents read/write access to this repo.
GITHUB_TOKEN=
GITHUB_REPO=wayfindercollective/theorder

# Branch the CMS commits to. Defaults to main if unset.
GITHUB_BRANCH=main

# Vercel Blob token for CMS image/video uploads.
BLOB_READ_WRITE_TOKEN=
